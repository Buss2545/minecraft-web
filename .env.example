# Local development only. On Railway, set these under
# your service -> Variables tab. This file is never read in production.

PORT=3000
NODE_ENV=production

# Required
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/marijpsmp?retryWrites=true&w=majority
ADMIN_KEY=change-this-to-a-long-random-admin-key

# Minecraft server the site advertises / delivers items to
MC_HOST=marijp2006.svmine.com
MC_PORT=11206

# Optional: lets the site send in-game commands (give items, /money, etc).
# Use EITHER RCON or the Pterodactyl panel API - Pterodactyl is usually the
# more reliable choice since it goes over normal HTTPS instead of a raw
# RCON port that many hosts firewall off.
# RCON_HOST=
# RCON_PORT=25575
# RCON_PASSWORD=
# PTERO_PANEL_URL=
# PTERO_SERVER_ID=
# PTERO_API_KEY=

# Optional: TikTok OAuth (follower count display)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://YOUR-DOMAIN/api/admin/tiktok/callback

# Optional: gameplay/economy tuning (all have working defaults in code)
# POINTS_PER_BAHT=1
# MONEY_PER_BAHT=1000
# MAX_MONEY_REDEEM_COUNT_PER_DAY=90
# MAX_ACTIVE_RESALE_LISTINGS_PER_USER=10
# RESALE_UNTRUSTED_MAX_PRICE=
# RACE_STAKE=
# RACE_CONSOLATION=
# WHEEL_STAKE=
# MONEY_GIVE_COMMAND=
# LUCKPERMS_GROUPS=
# LUCKPERMS_DURATION=
